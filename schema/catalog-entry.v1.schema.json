{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marginalia-os.github.io/schemas/catalog-entry.v1.schema.json",
  "title": "Marginalia Catalog Entry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "kind",
    "execution",
    "channel",
    "source",
    "target",
    "integrity",
    "artifact"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string" },
    "name": { "type": "string" },
    "version": { "type": "string" },
    "manifestSchemaVersion": {
      "type": "integer",
      "enum": [1, 2]
    },
    "kind": {
      "type": "string",
      "enum": ["theme", "sleep_screen", "reader_module", "integration", "app"]
    },
    "execution": {
      "type": "string",
      "enum": ["static", "module", "app"]
    },
    "nativeAbi": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "activation"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "type": {
            "type": "string",
            "enum": ["app", "service", "provider", "contribution"]
          },
          "contract": {
            "type": "string",
            "minLength": 3,
            "maxLength": 96,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*/[0-9]+$"
          },
          "activation": {
            "type": "string",
            "enum": ["on-demand", "manual", "boot", "always"]
          },
          "requires": {
            "type": "array",
            "maxItems": 16,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 64 }
          },
          "optional": {
            "type": "array",
            "maxItems": 16,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 64 }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": { "enum": ["provider", "contribution"] }
              }
            },
            "then": { "required": ["contract"] }
          }
        ]
      }
    },
    "channel": {
      "type": "string",
      "enum": ["stable", "beta", "experimental"]
    },
    "summary": { "type": "string" },
    "author": { "type": "string" },
    "homepage": { "type": "string" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "url", "ref"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["git"]
        },
        "url": { "type": "string" },
        "path": { "type": "string" },
        "ref": { "type": "string" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["devices", "chipFamilies", "minFirmware", "apiLevel", "ramClass", "requiresPSRAM"],
      "properties": {
        "devices": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "chipFamilies": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "architectures": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "osApi": {
          "type": "object",
          "additionalProperties": false,
          "required": ["major", "minMinor"],
          "properties": {
            "major": { "type": "integer", "minimum": 1 },
            "minMinor": { "type": "integer", "minimum": 0 }
          }
        },
        "minFirmware": { "type": "string" },
        "apiLevel": { "type": "integer" },
        "ramClass": { "type": "string" },
        "requiresPSRAM": { "type": "boolean" }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256"],
      "properties": {
        "sha256": { "type": "string" },
        "signature": { "type": "string" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "format", "size"],
      "properties": {
        "url": { "type": "string" },
        "size": { "type": "integer", "minimum": 0 },
        "format": {
          "type": "string",
          "enum": ["mpkg.zip"]
        }
      }
    },
    "deprecatedBy": { "type": "string" },
    "releasedAt": { "type": "string" },
    "updatedAt": { "type": "string" }
  },
  "allOf": [
    {
      "if": {
        "required": ["manifestSchemaVersion"],
        "properties": {
          "manifestSchemaVersion": { "const": 2 }
        }
      },
      "then": {
        "required": ["components"]
      }
    },
    {
      "if": {
        "required": ["components"]
      },
      "then": {
        "properties": {
          "manifestSchemaVersion": { "const": 2 }
        }
      }
    }
  ]
}
